# "$MMMM" for mihomo-manager-mihomo-mixin
# "$OUTPUT_PATH" for writing the final output
# "$TEMP_DIRECTORY" for temporary files (cleaned up after service stops)
# "$STATE_DIRECTORY" for persistent files (retained across runs)
# . for other configuration files

"$MMMM" \
    merge my-proxies.yaml \
    merge rules.yml \
    save "$OUTPUT_PATH"
